{
  "name": "scanifly-reseller-demo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "jwks": "cp app/server/jwks.json ./dist/app/server/",
    "build": "./node_modules/typescript/bin/tsc --project ./tsconfig.json",
    "build:prod": "cp app/jwks.json ./dist/app/jwks.json && cp package.json ./dist/package.json && cp yarn.lock ./dist/yarn.lock && cp -r .yarn ./dist/.yarn && cd ./dist && yarn workspaces focus --production",
    "lint": "./node_modules/typescript/bin/tsc && eslint .",
    "lint:fix": "./node_modules/typescript/bin/tsc && eslint --fix .",
    "local": "env nodemon ./app/index.ts",
    "prettier": "npx prettier --check app/**/*.ts",
    "prettier:write": "npx prettier --write app/**/*.ts",
    "routes": "tsoa spec-and-routes",
    "start": "node --trace-warnings --experimental-modules ./dist/app/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Demo server to interact with Scanifly APIs to add companies/users to embed into JWT",
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.3",
    "eslint": "^9.35.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "nodemonConfig": {
    "ignore": [
      ".git",
      "node_modules"
    ],
    "watch": [
      "app"
    ],
    "exec": "node --trace-warnings -r ts-node/register",
    "ext": "ts, js, yml"
  },
  "packageManager": "yarn@3.6.4",
  "dependencies": {
    "axios": "^1.12.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "tsoa": "^6.6.0"
  }
}
